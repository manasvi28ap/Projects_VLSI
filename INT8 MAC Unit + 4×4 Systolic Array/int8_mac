module int8_mac(
input wire clk, rst,
input wire signed [7:0] A,
input wire signed [7:0] B,
output reg signed [31:0] acc


    );
    wire signed [15:0] product;
    assign product=A*B;
    always @(posedge clk)
    begin
    if(rst) begin
    acc<= 0;
    end
    else begin 
    acc<=acc+product;
    end
    end
    
endmodule
